{
  "manifest_version": 3,
  "name": "KB Jarvis OS Browser Companion",
  "version": "13.0.0",
  "description": "Existing-session browser execution bridge for KB Jarvis OS 13. Developer: KB (Khuda Bakhsh).",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "KB Jarvis OS 13 Browser Companion",
    "default_popup": "popup.html"
  }
}