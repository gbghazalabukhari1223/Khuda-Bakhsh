<Window x:Class="KB.Jarvis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KB Jarvis OS 17 — Advanced Iron HUD"
        Width="1600" Height="960" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#020507" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Storyboard x:Key="CoreAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OuterRingRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:16"/>
            <DoubleAnimation Storyboard.TargetName="InnerRingRotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:9"/>
            <DoubleAnimation Storyboard.TargetName="ScannerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4.5"/>
            <DoubleAnimation Storyboard.TargetName="CoreGlow" Storyboard.TargetProperty="Opacity" From="0.58" To="1" AutoReverse="True" Duration="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="VoicePulse" Storyboard.TargetProperty="Opacity" From="0.25" To="0.95" AutoReverse="True" Duration="0:0:0.55"/>
        </Storyboard>
        <LinearGradientBrush x:Key="HudPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6071117" Offset="0"/>
            <GradientStop Color="#C50B1B22" Offset="0.6"/>
            <GradientStop Color="#A9050B0E" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="HudButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#DDFBFF"/>
            <Setter Property="Background" Value="#A7102028"/>
            <Setter Property="BorderBrush" Value="#4ED7F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HudPanelBrush}"/>
            <Setter Property="BorderBrush" Value="#3B92A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="#001014" BlurRadius="18" ShadowDepth="4" Opacity="0.8"/></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8EF5FF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TelemetryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#59F7D1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="96"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" RadiusX="0.86" RadiusY="0.95">
                <GradientStop Color="#15313B" Offset="0"/>
                <GradientStop Color="#071318" Offset="0.42"/>
                <GradientStop Color="#010305" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.22">
            <Path Stroke="#2DDDF4" StrokeThickness="0.55" Data="M0,120 L1600,120 M0,240 L1600,240 M0,360 L1600,360 M0,480 L1600,480 M0,600 L1600,600 M0,720 L1600,720 M0,840 L1600,840 M160,0 L160,960 M320,0 L320,960 M480,0 L480,960 M640,0 L640,960 M800,0 L800,960 M960,0 L960,960 M1120,0 L1120,960 M1280,0 L1280,960 M1440,0 L1440,960"/>
            <Path Stroke="#E77A2B" StrokeThickness="1.1" Opacity="0.6" Data="M0,86 L260,86 L286,60 M1314,60 L1340,86 L1600,86 M0,900 L330,900 L358,928 M1242,928 L1270,900 L1600,900"/>
        </Canvas>

        <Border Grid.Row="0" Background="#F102070A" BorderBrush="#4EC7DD" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="47" Height="47" VerticalAlignment="Center">
                    <Ellipse Stroke="#58EFFF" StrokeThickness="1.4"/>
                    <Ellipse Margin="6" Stroke="#F08B36" StrokeThickness="1" StrokeDashArray="3,3"/>
                    <TextBlock Text="KB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KB JARVIS" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="  OS 17" FontSize="23" FontWeight="Bold" Foreground="#FF9B3E"/>
                        <TextBlock Text="  ADVANCED IRON HUD" FontSize="11" Margin="12,8,0,0" Foreground="#68EEFF"/>
                    </StackPanel>
                    <TextBlock Text="WINDOWS · BROWSER · WORDPRESS · WHATSAPP · WEBSITE · FILE OPERATIONS · Developer: KB (Khuda Bakhsh)" FontSize="9.5" Foreground="#78AAB4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="#39BECE" BorderThickness="1" Padding="11,5" Margin="0,0,8,0" Background="#71121F24">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#5DFFB3" Margin="0,0,7,0"/><TextBlock Text="V17 ADVANCED ONLINE" Foreground="#7DFFD1" FontSize="10"/></StackPanel>
                    </Border>
                    <Button Style="{StaticResource HudButton}" Content="⚙" Width="42" Click="OpenSettings_Click"/>
                    <Button Style="{StaticResource HudButton}" Content="—" Width="42" Click="Minimize_Click"/>
                    <Button Style="{StaticResource HudButton}" Content="□" Width="42" Click="Maximize_Click"/>
                    <Button Style="{StaticResource HudButton}" Content="×" Width="42" Click="Close_Click" BorderBrush="#E55B53"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="350"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="TACTICAL MODULES" Foreground="#6DF3FF" FontSize="11" Margin="2,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Content="◉  COMMAND CORE" Tag="Dashboard" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◌  ADVANCED VOICE" Tag="Voice" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◈  WHATSAPP AGENT" Tag="WhatsApp" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▣  DESKTOP CONTROL" Tag="Desktop" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◎  BROWSER BRIDGE" Tag="Browser" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◐  VISUAL SENSORS" Tag="Vision" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▤  FILE OPERATIONS" Tag="Files" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⌘  WEBSITE STUDIO" Click="WebsiteStudio_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▶  YOUTUBE PLAYER" Click="YouTubeTemplate_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⬡  SKILL MATRIX" Tag="Skills" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◇  TRAINING LAB" Tag="Training" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="◫  MISSION MEMORY" Tag="Memory" Click="ModuleButton_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙  SYSTEM SETTINGS" Click="OpenSettings_Click"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#CE7933" BorderThickness="1,0,0,1" Padding="11" Margin="0,14,0,0" Background="#82130B08">
                        <StackPanel>
                            <TextBlock Text="IDENTITY LOCK" Foreground="#FFAE62" FontSize="10"/>
                            <TextBlock Text="JARVIS / FEMALE EXECUTIVE" Margin="0,7,0,0" FontSize="11"/>
                            <TextBlock Text="DEVELOPER · KB (Khuda Bakhsh)" Foreground="#8FC3CD" FontSize="10"/>
                            <TextBlock Text="VERSION · 17.0.0" Foreground="#67F2FF" FontFamily="Consolas" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="205"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,10,10" BorderBrush="#54D7EA">
                    <Grid>
                        <Grid x:Name="DashboardSurface">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="ARC INTELLIGENCE · EXECUTION CORE" Foreground="#78F4FF" FontSize="11"/>
                                <TextBlock x:Name="CoreStateText" Text="ONLINE · READY" HorizontalAlignment="Right" Foreground="#66FFC0" FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="18,4">
                                <Grid Width="560" Height="560">
                                    <Ellipse Width="530" Height="530" Stroke="#23515E"/>
                                    <Ellipse Width="510" Height="510" Stroke="#50E5F5" StrokeThickness="2" StrokeDashArray="1,8" Opacity="0.75">
                                        <Ellipse.RenderTransform><RotateTransform x:Name="OuterRingRotate" CenterX="255" CenterY="255"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="438" Height="438" Stroke="#E57B31" StrokeThickness="2.5" StrokeDashArray="16,7,3,7" Opacity="0.85">
                                        <Ellipse.RenderTransform><RotateTransform x:Name="InnerRingRotate" CenterX="219" CenterY="219"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="365" Height="365" Stroke="#37DCF0" StrokeThickness="1.4" StrokeDashArray="2,5"/>
                                    <Grid Width="460" Height="460">
                                        <Grid.RenderTransform><RotateTransform x:Name="ScannerRotate" CenterX="230" CenterY="230"/></Grid.RenderTransform>
                                        <Path Data="M230,230 L230,18 A212,212 0 0 1 378,78 Z" Fill="#1A51EEFF"/>
                                    </Grid>
                                    <Polygon Points="280,152 384,212 384,334 280,394 176,334 176,212" Fill="#090D1519" Stroke="#67F2FF" StrokeThickness="3"/>
                                    <Polygon Points="280,188 352,230 352,316 280,358 208,316 208,230" Fill="#3A22D8EF" Stroke="#F1A24D" StrokeThickness="2"/>
                                    <Ellipse x:Name="CoreGlow" Width="174" Height="174" Opacity="0.88">
                                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#E081F6FF" Offset="0.18"/><GradientStop Color="#C128DFF2" Offset="0.48"/><GradientStop Color="#00128798" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="JARVIS" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ADVANCED CORE V17" FontSize="11" Foreground="#FFB45E" HorizontalAlignment="Center"/>
                                        <TextBlock Text="SENSE · REASON · EXECUTE · VERIFY" FontSize="7.5" Foreground="#80D9E5" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>
                            <UniformGrid Grid.Row="2" Columns="5" Margin="12,0,12,8">
                                <Border BorderBrush="#36AABA" BorderThickness="1" Padding="7" Margin="3"><TextBlock Style="{StaticResource ModeLabel}" Text="VOICE PRIORITY"/></Border>
                                <Border BorderBrush="#36AABA" BorderThickness="1" Padding="7" Margin="3"><TextBlock Style="{StaticResource ModeLabel}" Text="MISSION MEMORY"/></Border>
                                <Border BorderBrush="#36AABA" BorderThickness="1" Padding="7" Margin="3"><TextBlock Style="{StaticResource ModeLabel}" Text="OBJECT CONTROL"/></Border>
                                <Border BorderBrush="#36AABA" BorderThickness="1" Padding="7" Margin="3"><TextBlock Style="{StaticResource ModeLabel}" Text="WEB OPERATIONS"/></Border>
                                <Border BorderBrush="#C67B37" BorderThickness="1" Padding="7" Margin="3"><TextBlock Style="{StaticResource ModeLabel}" Text="VERIFIED ACTIONS"/></Border>
                            </UniformGrid>
                            <StackPanel Grid.Row="3" HorizontalAlignment="Center" MaxWidth="850">
                                <TextBlock x:Name="MissionTitleText" Text="Awaiting your mission, Boss." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="MissionDetailText" Text="Voice, browser, websites, WordPress, WhatsApp, files and desktop operations are standing by." Foreground="#8DBBC5" Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ModuleSurface" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <StackPanel><TextBlock x:Name="ModuleTitleText" Text="MODULE" Foreground="#71F0FF" FontSize="11"/><TextBlock x:Name="ModuleSubtitleText" Text="Operational workspace" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                                <Button Style="{StaticResource HudButton}" Content="RETURN TO CORE" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BackToDashboard_Click"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,14">
                                <StackPanel>
                                    <Border BorderBrush="#39A9BC" BorderThickness="1,0,0,1" Background="#8A0E2026" Padding="17">
                                        <StackPanel>
                                            <TextBlock x:Name="ModuleStatusText" Text="READY" Foreground="#69FFC0" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ModuleDescriptionText" Text="Module description" FontSize="17" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                            <TextBlock x:Name="ModuleDetailsText" Text="Module details" Foreground="#91B9C2" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="AVAILABLE OPERATIONS" Foreground="#72F0FF" FontSize="11" Margin="2,18,0,6"/>
                                    <UniformGrid Columns="2">
                                        <Button x:Name="PrimaryModuleActionButton" Style="{StaticResource ActionButton}" Content="PRIMARY ACTION" Click="PrimaryModuleAction_Click"/>
                                        <Button x:Name="SecondaryModuleActionButton" Style="{StaticResource ActionButton}" Content="SECONDARY ACTION" Click="SecondaryModuleAction_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Grid.Row="2" x:Name="ModuleResultText" Text="Select an operation to run it." Foreground="#A8F4C1" TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,10,0" BorderBrush="#B66A2B">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><TextBlock Text="MISSION TIMELINE / VERIFIED EVIDENCE STREAM" Foreground="#72F2FF" FontSize="11"/><Button Style="{StaticResource HudButton}" Content="CLEAR" HorizontalAlignment="Right" Padding="10,3" Click="ClearLog_Click"/></Grid>
                        <ListBox x:Name="MissionLog" Grid.Row="1" Margin="0,8,0,0" Background="#45020608" BorderThickness="0" Foreground="#9BEAD8" FontFamily="Consolas" FontSize="11.5"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="RightPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10" BorderBrush="#59DFEE">
                        <StackPanel>
                            <Grid><TextBlock Text="VOICE REACTOR HEALTH" Foreground="#72F3FF" FontSize="11"/><Ellipse x:Name="VoicePulse" Width="11" Height="11" Fill="#5DFFB3" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Engine"/><TextBlock x:Name="VoiceModeText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="STANDBY"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Playback buffer"/><TextBlock x:Name="VoiceBufferText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="0 ms"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Adaptive target"/><TextBlock x:Name="VoiceTargetText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="300 ms"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Underruns"/><TextBlock x:Name="VoiceUnderrunText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="0"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mic queue"/><TextBlock x:Name="VoiceMicQueueText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="0"/></Grid>
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Barge-ins"/><TextBlock x:Name="VoiceBargeInText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="0"/></Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SYSTEM TELEMETRY" Foreground="#72F3FF" FontSize="11"/>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Native execution"/><TextBlock Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="READY"/></Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Skill engine"/><TextBlock x:Name="SkillCountText" Grid.Column="1" Style="{StaticResource TelemetryValue}" Text="0 SKILLS"/></Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Browser companion"/><TextBlock x:Name="BrowserStatusText" Grid.Column="1" Text="CHECKING" Foreground="#FFC757"/></Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Gemini Live"/><TextBlock x:Name="VoiceStatusText" Grid.Column="1" Text="CHECKING" Foreground="#FFC757"/></Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10" BorderBrush="#C97631">
                        <StackPanel>
                            <TextBlock Text="LIVE INTELLIGENCE" Foreground="#FFAA58" FontSize="11"/>
                            <Button Style="{StaticResource HudButton}" Content="START LISTENING" Click="StartVoice_Click" Margin="0,9,0,3" BorderBrush="#38E6BA"/>
                            <Button Style="{StaticResource HudButton}" Content="STOP VOICE" Click="StopVoice_Click" Margin="0,3" BorderBrush="#E35C55"/>
                            <Button Style="{StaticResource HudButton}" Content="GEMINI &amp; VOICE SETTINGS" Click="OpenSettings_Click" Margin="0,3"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="VISUAL SENSOR ARRAY" Foreground="#72F3FF" FontSize="11"/>
                            <Grid Margin="0,9,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Screen sensor"/><TextBlock x:Name="ScreenVisionStatusText" Grid.Column="1" Text="OFF" Foreground="#FFC757"/></Grid>
                            <Border Height="92" Background="#020609" BorderBrush="#3193A6" BorderThickness="1"><Image x:Name="ScreenPreviewImage" Stretch="Uniform"/></Border>
                            <Button x:Name="ScreenVisionButton" Style="{StaticResource HudButton}" Content="START SCREEN" Click="ToggleScreenVision_Click" Margin="0,5,0,8"/>
                            <Grid Margin="0,2,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Camera sensor"/><TextBlock x:Name="CameraVisionStatusText" Grid.Column="1" Text="OFF" Foreground="#FFC757"/></Grid>
                            <Border Height="92" Background="#020609" BorderBrush="#3193A6" BorderThickness="1"><Image x:Name="CameraPreviewImage" Stretch="Uniform"/></Border>
                            <Button x:Name="CameraVisionButton" Style="{StaticResource HudButton}" Content="START CAMERA" Click="ToggleCameraVision_Click" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="RAPID OPERATIONS" Foreground="#72F3FF" FontSize="11"/>
                            <Button Style="{StaticResource HudButton}" Content="Organize Desktop Notepad files" Click="OrganizeNotes_Click" Margin="0,9,0,3"/>
                            <Button Style="{StaticResource HudButton}" Content="Create HTML CSS JS website" Click="WebsiteStudio_Click" Margin="0,3"/>
                            <Button Style="{StaticResource HudButton}" Content="Play a song on YouTube…" Click="YouTubeTemplate_Click" Margin="0,3"/>
                            <Button Style="{StaticResource HudButton}" Content="Prepare WordPress draft command…" Click="WordPressTemplate_Click" Margin="0,3"/>
                            <Button Style="{StaticResource HudButton}" Content="Write and open a Notepad note" Click="NotepadDemo_Click" Margin="0,3"/>
                            <Button Style="{StaticResource HudButton}" Content="Inspect existing WhatsApp chat" Click="WhatsAppInspect_Click" Margin="0,3"/>
                            <Button Style="{StaticResource HudButton}" Content="Test Browser Companion" Click="BrowserTest_Click" Margin="0,3"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#45CFE0" BorderThickness="0,1,0,0" Padding="14,10" Background="#F3050B0E">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="BOSS COMMAND · V17" Foreground="#78F4FF" FontSize="10"/><TextBlock Text="Speak naturally or enter a complete operational mission" Foreground="#8BAFB8" FontSize="10"/></StackPanel>
                <Border Grid.Column="1" BorderBrush="#4BDFF0" BorderThickness="1" Background="#B20A161C" Padding="1">
                    <TextBox x:Name="CommandBox" FontSize="16" Padding="14,12" Background="#071116" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="CommandBox_KeyDown"/>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource HudButton}" Content="EXECUTE MISSION" Width="160" Margin="10,0,0,0" FontWeight="SemiBold" Click="Execute_Click" BorderBrush="#FF9C44"/>
            </Grid>
        </Border>
    </Grid>
</Window>
