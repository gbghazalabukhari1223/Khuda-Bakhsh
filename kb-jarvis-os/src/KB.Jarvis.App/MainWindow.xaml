<Window x:Class="KB.Jarvis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KB Jarvis OS"
        Width="1480" Height="900"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#05070A"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Storyboard x:Key="CoreAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OuterRingRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:12" />
            <DoubleAnimation Storyboard.TargetName="InnerRingRotate" Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:7" />
            <DoubleAnimation Storyboard.TargetName="CoreGlow" Storyboard.TargetProperty="Opacity"
                             From="0.35" To="1" AutoReverse="True" Duration="0:0:1.2" />
        </Storyboard>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#234F61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#112434" Offset="0" />
                <GradientStop Color="#06090D" Offset="0.58" />
                <GradientStop Color="#020304" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#DD070A0F" BorderBrush="#1E5B70" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5">
                        <TextBlock Text="KB" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="KB JARVIS OS" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Native Operating Assistant · Developer: KB (Khuda Bakhsh)" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" Width="42" Click="Minimize_Click" ToolTip="Minimize KB Jarvis" />
                    <Button Content="□" Width="42" Click="Maximize_Click" ToolTip="Maximize or restore" />
                    <Button Content="×" Width="42" Click="Close_Click" ToolTip="Close KB Jarvis only" BorderBrush="#713244" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="COMMAND MODULES" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="4,2,0,10" />
                        <Button Style="{StaticResource NavButton}" Content="◉  Dashboard" Tag="Dashboard" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◌  Voice" Tag="Voice" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◈  WhatsApp" Tag="WhatsApp" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="▣  Desktop" Tag="Desktop" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◎  Browser" Tag="Browser" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◐  Vision" Tag="Vision" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="▤  Files" Tag="Files" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="⬡  Skills" Tag="Skills" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◇  Training" Tag="Training" Click="ModuleButton_Click" />
                        <Button Style="{StaticResource NavButton}" Content="◫  Memory" Tag="Memory" Click="ModuleButton_Click" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#254C5B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="SYSTEM IDENTITY" Foreground="{StaticResource CyanBrush}" FontSize="10" />
                            <TextBlock Text="Assistant: Jarvis" Margin="0,8,0,0" />
                            <TextBlock Text="Developer: KB" />
                            <TextBlock Text="Khuda Bakhsh" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Version 11.1.0" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,12">
                    <Grid>
                        <Grid x:Name="DashboardSurface">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="NEURAL EXECUTION CORE" Foreground="{StaticResource CyanBrush}" FontSize="12" />
                                <TextBlock x:Name="CoreStateText" Text="ONLINE · READY" HorizontalAlignment="Right" Foreground="#5DFF8C" FontSize="12" />
                            </Grid>

                            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="48,12">
                                <Grid Width="470" Height="470">
                                    <Ellipse Width="430" Height="430" Stroke="#1B7996" StrokeThickness="2" StrokeDashArray="2,5" Opacity="0.7">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="OuterRingRotate" CenterX="215" CenterY="215" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="340" Height="340" Stroke="#E82B48" StrokeThickness="2" StrokeDashArray="9,5" Opacity="0.65">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="InnerRingRotate" CenterX="170" CenterY="170" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="250" Height="250" Stroke="#35DFFF" StrokeThickness="3" Opacity="0.7" />
                                    <Ellipse x:Name="CoreGlow" Width="195" Height="195" Opacity="0.8">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#E8FFFFFF" Offset="0" />
                                                <GradientStop Color="#B821D9FF" Offset="0.35" />
                                                <GradientStop Color="#1718A9D1" Offset="0.75" />
                                                <GradientStop Color="#0018A9D1" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border Width="136" Height="136" CornerRadius="68" Background="#C007111A" BorderBrush="#63E9FF" BorderThickness="2">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="JARVIS" HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#E9FCFF" />
                                            <TextBlock Text="KB CORE" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource CyanBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Viewbox>

                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" MaxWidth="700">
                                <TextBlock x:Name="MissionTitleText" Text="Awaiting your mission, Boss." FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="MissionDetailText" Text="Buttons and verified skills are ready for execution." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ModuleSurface" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="ModuleTitleText" Text="MODULE" Foreground="{StaticResource CyanBrush}" FontSize="12" />
                                    <TextBlock x:Name="ModuleSubtitleText" Text="Operational workspace" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                                </StackPanel>
                                <Button Content="BACK TO CORE" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BackToDashboard_Click" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,14">
                                <StackPanel>
                                    <Border BorderBrush="#24556A" BorderThickness="1" Background="#71101821" CornerRadius="7" Padding="16">
                                        <StackPanel>
                                            <TextBlock x:Name="ModuleStatusText" Text="READY" Foreground="#5DFF8C" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ModuleDescriptionText" Text="Module description" FontSize="17" TextWrapping="Wrap" Margin="0,10,0,0" />
                                            <TextBlock x:Name="ModuleDetailsText" Text="Module details" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="AVAILABLE OPERATIONS" Foreground="{StaticResource CyanBrush}" FontSize="11" Margin="2,18,0,6" />
                                    <UniformGrid Columns="2">
                                        <Button x:Name="PrimaryModuleActionButton" Style="{StaticResource ActionButton}" Content="PRIMARY ACTION" Click="PrimaryModuleAction_Click" />
                                        <Button x:Name="SecondaryModuleActionButton" Style="{StaticResource ActionButton}" Content="SECONDARY ACTION" Click="SecondaryModuleAction_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Grid.Row="2" x:Name="ModuleResultText" Text="Select an operation to run it." Foreground="#A8F4C1" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="MISSION TIMELINE" Foreground="{StaticResource CyanBrush}" FontSize="11" />
                            <Button Content="Clear" HorizontalAlignment="Right" Padding="10,3" Click="ClearLog_Click" />
                        </Grid>
                        <ListBox x:Name="MissionLog" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="#A8F4C1" FontFamily="Consolas" FontSize="12" />
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM TELEMETRY" Foreground="{StaticResource CyanBrush}" FontSize="11" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Native execution" />
                                <TextBlock Grid.Column="1" Text="READY" Foreground="#5DFF8C" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Skill engine" />
                                <TextBlock x:Name="SkillCountText" Grid.Column="1" Text="0 SKILLS" Foreground="#5DFF8C" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Browser companion" />
                                <TextBlock x:Name="BrowserStatusText" Grid.Column="1" Text="CHECKING" Foreground="#FFC757" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Memory" />
                                <TextBlock Grid.Column="1" Text="LOCAL" Foreground="#5DFF8C" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="QUICK OPERATIONS" Foreground="{StaticResource CyanBrush}" FontSize="11" />
                            <Button Content="Write and open a Notepad note" Click="NotepadDemo_Click" Margin="0,10,0,3" />
                            <Button Content="Inspect current WhatsApp chat" Click="WhatsAppInspect_Click" Margin="0,3" />
                            <Button Content="List active browser tabs" Click="BrowserTabs_Click" Margin="0,3" />
                            <Button Content="Who created you?" Click="Identity_Click" Margin="0,3" />
                            <Button Content="Test Browser Companion" Click="BrowserTest_Click" Margin="0,3" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ACTIVE SAFETY" Foreground="{StaticResource RedBrush}" FontSize="11" />
                            <TextBlock Text="Normal navigation, app opening, inspection and typing execute without repeated approval." TextWrapping="Wrap" Margin="0,9,0,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Sending, publishing, deleting and power actions require one final confirmation." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="‘Close Jarvis’ only closes this application." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#FFC6D0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="DEVELOPER SIGNATURE" Foreground="{StaticResource CyanBrush}" FontSize="11" />
                            <TextBlock Text="KB (Khuda Bakhsh)" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,0" />
                            <TextBlock Text="Native AI Operating Environment" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#E8070B10" BorderBrush="#1F6377" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="BOSS COMMAND" Foreground="{StaticResource CyanBrush}" FontSize="10" />
                    <TextBlock Text="Enter to execute" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </StackPanel>
                <TextBox x:Name="CommandBox" Grid.Column="1" FontSize="17" Padding="14,12" Background="#121A23" Foreground="White"
                         BorderBrush="#2C7790" BorderThickness="1" VerticalContentAlignment="Center"
                         KeyDown="CommandBox_KeyDown" />
                <Button Grid.Column="2" Content="EXECUTE" Width="124" Margin="12,0,0,0" FontWeight="SemiBold" Click="Execute_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
