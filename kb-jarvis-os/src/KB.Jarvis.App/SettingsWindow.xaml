<Window x:Class="KB.Jarvis.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KB Jarvis Settings"
        Width="620" Height="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#071019"
        Foreground="#EAFBFF">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121E29" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="BorderBrush" Value="#2B7189" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,5,0,14" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#121E29" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="BorderBrush" Value="#2B7189" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,5,0,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#162532" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="BorderBrush" Value="#2FCBEF" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="JARVIS INTELLIGENCE SETTINGS" Foreground="#2FDFFF" FontSize="13" />
            <TextBlock Text="Gemini Live Voice and Agent Runtime" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,5" />
            <TextBlock Text="The API key is encrypted with Windows DPAPI for this Windows account." Foreground="#88AAB8" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,10">
            <StackPanel>
                <TextBlock Text="Gemini API key" />
                <PasswordBox x:Name="ApiKeyBox" />
                <TextBlock Text="Live voice model" />
                <TextBox x:Name="LiveModelBox" />
                <TextBlock Text="Text planner model" />
                <TextBox x:Name="TextModelBox" />
                <TextBlock Text="Gemini voice" />
                <TextBox x:Name="VoiceNameBox" />
                <CheckBox x:Name="AutoReconnectBox" Content="Automatically reconnect Gemini Live after a temporary disconnect" Margin="0,8" />
                <CheckBox x:Name="SpeakRepliesBox" Content="Speak text-agent replies using the Windows voice fallback" Margin="0,8" />
                <Border Background="#111C25" BorderBrush="#275668" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <TextBlock Text="Recommended defaults: gemini-3.1-flash-live-preview, gemini-3.6-flash, Kore. API quota and billing remain controlled by your Google project." TextWrapping="Wrap" Foreground="#9ABAC5" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Click="Cancel_Click" />
            <Button Content="SAVE SETTINGS" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>