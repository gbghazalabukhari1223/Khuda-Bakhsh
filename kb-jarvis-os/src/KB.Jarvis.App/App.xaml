<Application x:Class="KB.Jarvis.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#B20A1018" />
        <SolidColorBrush x:Key="CyanBrush" Color="#21D9FF" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF334E" />
        <SolidColorBrush x:Key="TextBrush" Color="#EAFBFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#82A7B5" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#181F2B" />
            <Setter Property="BorderBrush" Value="#356477" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
