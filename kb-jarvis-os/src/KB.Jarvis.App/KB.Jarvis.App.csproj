<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KB_Jarvis_OS</AssemblyName>
    <RootNamespace>KB.Jarvis.App</RootNamespace>
    <Version>11.2.0</Version>
    <FileVersion>11.2.0.0</FileVersion>
    <AssemblyVersion>11.2.0.0</AssemblyVersion>
    <Authors>KB (Khuda Bakhsh)</Authors>
    <Company>KB</Company>
    <Product>KB Jarvis OS</Product>
    <Description>Native Windows operating assistant developed by KB (Khuda Bakhsh).</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>